// MyNextMovieTests unit test target. Tests run inside the app.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.fwsoft.MyNextMovieTests

GENERATE_INFOPLIST_FILE = YES
SWIFT_EMIT_LOC_STRINGS = NO

TEST_HOST = $(BUILT_PRODUCTS_DIR)/MyNextMovie.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/MyNextMovie
BUNDLE_LOADER = $(TEST_HOST)
