// Copy this file to Config/Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is listed in .gitignore.

TMDB_API_KEY = your_tmdb_api_key

// In xcconfig "//" starts a comment, so the URL is written with $().
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your_anon_key
